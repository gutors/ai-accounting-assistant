<% content_for :title, "#{@organization.name} — Configuração" %>

<h1 class="text-2xl leading-7 font-semibold tracking-[-0.01em]">Configuração</h1>

<% if @accountant_error.present? %>
  <div class="mt-6"><%= render "shared/notice", message: @accountant_error %></div>
<% end %>
<% if @certificate_error.present? %>
  <div class="mt-6"><%= render "shared/notice", message: @certificate_error %></div>
<% end %>

<div class="mt-10 space-y-12">
  <section>
    <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Contador</h2>
    <% accountant_reading = @organization.accountant_presentation_name.present? && !@accountant_editing %>
    <% if @organization.accountant_presentation_name.blank? %>
      <p class="mb-4">Cadastre o contador</p>
    <% end %>
    <% if accountant_reading %>
      <div class="grid max-w-3xl gap-4 md:grid-cols-2">
        <div>
          <label for="presentation_name" class="mb-1 block font-medium">Nome de apresentação</label>
          <p id="presentation_name" class="font-medium"><%= @organization.accountant_presentation_name %></p>
        </div>
        <div>
          <label for="tax_id" class="mb-1 block font-medium">CPF/CNPJ (preencher apenas números)</label>
          <p id="tax_id" class="font-medium"><%= BrazilianTaxId.format(@organization.accountant_tax_id) %></p>
        </div>
        <div>
          <label for="legal_name" class="mb-1 block font-medium">Razão social</label>
          <p id="legal_name" class="font-medium"><%= @organization.accountant_legal_name %></p>
        </div>
        <div>
          <label for="pix_key" class="mb-1 block font-medium">PIX</label>
          <p id="pix_key" class="font-medium"><%= @organization.accountant_pix_key %></p>
        </div>
        <div>
          <label for="destination_email" class="mb-1 block font-medium">Email para envio</label>
          <p id="destination_email" class="font-medium"><%= @organization.package_destination_email %></p>
        </div>
        <div class="md:col-span-2">
          <%= link_to "Editar", "/setup?edit=accountant", class: "inline-block rounded bg-caixa px-4 py-2 font-semibold text-white" %>
        </div>
      </div>
    <% else %>
      <%= form_with url: "/accountant", method: :patch, class: "grid max-w-3xl gap-4 md:grid-cols-2" do %>
        <div>
          <label for="presentation_name" class="mb-1 block font-medium">Nome de apresentação</label>
          <%= text_field_tag :presentation_name, @organization.accountant_presentation_name.to_s, id: "presentation_name", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
        </div>
        <div>
          <label for="tax_id" class="mb-1 block font-medium">CPF/CNPJ (preencher apenas números)</label>
          <%= text_field_tag :tax_id, @organization.accountant_tax_id.to_s, id: "tax_id", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
        </div>
        <div>
          <label for="legal_name" class="mb-1 block font-medium">Razão social</label>
          <%= text_field_tag :legal_name, @organization.accountant_legal_name.to_s, id: "legal_name", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "organization" %>
        </div>
        <div>
          <label for="pix_key" class="mb-1 block font-medium">PIX</label>
          <%= text_field_tag :pix_key, @organization.accountant_pix_key.to_s, id: "pix_key", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
        </div>
        <div>
          <label for="destination_email" class="mb-1 block font-medium">Email para envio</label>
          <%= email_field_tag :destination_email, @organization.package_destination_email.to_s, id: "destination_email", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "email" %>
        </div>
        <div class="md:col-span-2">
          <%= submit_tag "Salvar contador", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
        </div>
      <% end %>
    <% end %>
  </section>

  <section>
    <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Armazenamento do pacote mensal</h2>
    <% archive_reading = @organization.package_archive_url.present? && !@package_archive_editing %>
    <% if @organization.package_archive_url.blank? %>
      <p class="mb-4">Cole a URL da pasta do Google Drive</p>
    <% end %>
    <% if archive_reading %>
      <div class="max-w-3xl space-y-4">
        <div>
          <label for="url" class="mb-1 block font-medium">URL da pasta do Google Drive</label>
          <p id="url" class="font-medium"><%= @organization.package_archive_url %></p>
        </div>
        <%= link_to "Editar", "/setup?edit=package_archive", class: "inline-block rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      </div>
    <% else %>
      <%= form_with url: "/package_archive", method: :patch, class: "max-w-3xl space-y-4" do %>
        <div>
          <label for="url" class="mb-1 block font-medium">URL da pasta do Google Drive</label>
          <%= url_field_tag :url, @organization.package_archive_url, id: "url", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
        </div>
        <%= submit_tag(@organization.package_archive_url.present? ? "Confirmar" : "Salvar arquivo", class: "rounded bg-caixa px-4 py-2 font-semibold text-white") %>
      <% end %>
    <% end %>
  </section>

  <section>
    <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Certificado Digital A1 - Para consulta na SEFAZ</h2>
    <% if @organization.sefaz_titular_cnpj.blank? %>
      <p class="mb-4">Não há certificado A1 instalado. Use Instalar certificado.</p>
    <% else %>
      <p class="font-medium"><%= @organization.sefaz_titular_display %></p>
      <% if @organization.sefaz_certificate_expired? %>
        <p class="text-margem">Expirado em <%= l(@organization.sefaz_not_after) %></p>
      <% else %>
        <p class="text-ink-soft">Válido até <%= l(@organization.sefaz_not_after) %></p>
      <% end %>
      <%= button_to "Remover", "/sefaz_certificate", method: :delete, form: { data: { turbo_confirm: "Remover o certificado SEFAZ?" } }, form_class: "mt-2 mb-4", class: "text-margem underline underline-offset-2" %>
    <% end %>
    <details<% if @certificate_error.present? %> open<% end %>>
      <summary class="cursor-pointer font-medium text-caixa">Instalar certificado</summary>
      <%= form_with url: "/sefaz_certificate", method: :post, multipart: true, class: "mt-3 grid max-w-3xl gap-4 rounded border border-rule bg-sheet p-4 md:grid-cols-2" do %>
        <div>
          <label for="certificate" class="mb-1 block font-medium">Arquivo</label>
          <%= file_field_tag :certificate, id: "certificate", class: "block w-full max-w-full text-meta" %>
        </div>
        <div>
          <label for="passphrase" class="mb-1 block font-medium">Senha</label>
          <%= password_field_tag :passphrase, nil, id: "passphrase", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
        </div>
        <div class="md:col-span-2">
          <%= submit_tag "Instalar certificado", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
        </div>
      <% end %>
    </details>
  </section>

  <section>
    <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Contas bancárias</h2>
    <% if @bank_accounts.empty? %>
      <p class="mb-4">Nenhuma conta bancária</p>
    <% else %>
      <ul class="mb-6">
        <% @bank_accounts.each do |bank_account| %>
          <li data-row="bank-account" data-bank-account-id="<%= bank_account.id %>" class="grid gap-x-6 gap-y-2 border-b border-rule py-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_12rem]">
            <div>
              <p class="font-medium"><%= bank_account.name %></p>
              <p class="text-meta text-ink-soft">extrato-<%= bank_account.slug %></p>
              <% if bank_account.coordinates.present? %>
                <p class="text-meta text-ink-soft"><%= bank_account.coordinates %></p>
              <% end %>
            </div>
            <div>
              <% if bank_account.active? %>
                <%= button_to "Desativar", "/bank_accounts/#{bank_account.id}", method: :patch, params: { active: false }, class: "text-margem underline underline-offset-2" %>
              <% else %>
                <p class="text-ink-soft">Inativa</p>
                <%= button_to "Reativar", "/bank_accounts/#{bank_account.id}", method: :patch, params: { active: true }, class: "text-caixa underline underline-offset-2" %>
              <% end %>
            </div>
            <details class="md:col-span-3">
              <summary class="cursor-pointer font-medium text-caixa">Editar</summary>
              <%= form_with url: "/bank_accounts/#{bank_account.id}", method: :patch, class: "mt-3 grid max-w-3xl gap-4 rounded border border-rule bg-sheet p-4 md:grid-cols-2" do %>
                <div>
                  <label for="name_<%= bank_account.id %>" class="mb-1 block font-medium">Nome</label>
                  <%= text_field_tag :name, bank_account.name, id: "name_#{bank_account.id}", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
                </div>
                <div>
                  <label for="compe_<%= bank_account.id %>" class="mb-1 block font-medium">Banco</label>
                  <%= select_tag :compe, options_from_collection_for_select(@banks, :compe, :presentation_name, bank_account.bank.compe), id: "compe_#{bank_account.id}", class: "w-full rounded border border-rule bg-sheet px-3 py-2" %>
                </div>
                <div>
                  <label for="coordinates_<%= bank_account.id %>" class="mb-1 block font-medium">Coordenadas</label>
                  <%= text_field_tag :coordinates, bank_account.coordinates, id: "coordinates_#{bank_account.id}", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
                </div>
                <div class="md:col-span-2">
                  <%= submit_tag "Salvar conta", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
                </div>
              <% end %>
            </details>
          </li>
        <% end %>
      </ul>
    <% end %>

    <%= form_with url: "/bank_accounts", method: :post, class: "grid max-w-3xl gap-4 md:grid-cols-2" do %>
      <div>
        <label for="name" class="mb-1 block font-medium">Nome</label>
        <%= text_field_tag :name, nil, id: "name", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
      </div>
      <div>
        <label for="compe" class="mb-1 block font-medium">Banco</label>
        <%= select_tag :compe, options_from_collection_for_select(@banks, :compe, :presentation_name), id: "compe", class: "w-full rounded border border-rule bg-sheet px-3 py-2" %>
      </div>
      <div>
        <label for="coordinates" class="mb-1 block font-medium">Coordenadas</label>
        <%= text_field_tag :coordinates, nil, id: "coordinates", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
      </div>
      <div class="md:col-span-2">
        <%= submit_tag "Adicionar conta", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      </div>
    <% end %>
  </section>

  <section>
    <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Tipos extras de exceção</h2>
    <ul class="mb-6">
      <li data-row="extras-column-headings" class="grid gap-x-6 gap-y-2 border-b border-rule py-3 text-meta text-ink-soft md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_12rem]">
        <span></span>
        <span>Justificativa</span>
      </li>
      <% ExtraExceptionKind::BASE_NAMES.each do |name| %>
        <li data-row="base-document-exception" class="grid gap-x-6 gap-y-2 border-b border-rule py-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_12rem]">
          <p class="font-medium"><%= name %></p>
          <p><%= ExtraExceptionKind::BASE_JUSTIFICATIONS.fetch(name) %></p>
        </li>
      <% end %>
      <% @extra_exception_kinds.each do |extra_exception_kind| %>
        <li data-row="extra-exception-kind" data-extra-exception-kind-id="<%= extra_exception_kind.id %>" class="grid gap-x-6 gap-y-2 border-b border-rule py-3 md:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_12rem]">
          <p class="font-medium"><%= extra_exception_kind.name %></p>
          <p><%= extra_exception_kind.justification %></p>
          <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
            <% if extra_exception_kind.active? %>
              <%= button_to "Desativar", "/extra_exception_kinds/#{extra_exception_kind.id}", method: :patch, params: { active: false }, class: "text-margem underline underline-offset-2" %>
            <% else %>
              <p class="text-ink-soft">Desativado</p>
              <%= button_to "Reativar", "/extra_exception_kinds/#{extra_exception_kind.id}", method: :patch, params: { active: true }, class: "text-caixa underline underline-offset-2" %>
            <% end %>
            <% if extra_exception_kind.payments.none? %>
              <%= button_to "Excluir", "/extra_exception_kinds/#{extra_exception_kind.id}", method: :delete, class: "text-margem underline underline-offset-2" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <%= form_with url: "/extra_exception_kinds", method: :post, class: "grid max-w-3xl gap-4 md:grid-cols-2" do %>
      <div>
        <label for="extra_exception_kind_name" class="mb-1 block font-medium">Nome</label>
        <%= text_field_tag :name, nil, id: "extra_exception_kind_name", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
      </div>
      <div>
        <label for="extra_exception_kind_justification" class="mb-1 block font-medium">Justificativa</label>
        <%= text_field_tag :justification, nil, id: "extra_exception_kind_justification", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
      </div>
      <div class="md:col-span-2">
        <%= submit_tag "Adicionar tipo extra", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      </div>
    <% end %>
  </section>
</div>
