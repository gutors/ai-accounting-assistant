<% content_for :title, "#{@organization.name} — Configuração" %>
<% content_for :body_class, "flex h-dvh flex-col overflow-hidden" %>
<% content_for :main_class, "desk grid min-h-0 flex-1 overflow-hidden md:grid-cols-[26rem_1fr]" %>

<aside data-desk="index" class="flex min-h-0 flex-col overflow-hidden border-rule px-8 pt-10 md:border-r md:pr-6">
  <h2 class="mb-2 border-b border-rule pb-2 text-lg leading-6 font-semibold">Configuração</h2>
  <nav aria-label="Itens de configuração">
    <% @setup_desk.rows.each do |row| %>
      <%= link_to row.href, class: "desk-item-link#{' is-block' if row.blocked?}", aria: { current: ("true" if row.selected?) } do %>
        <span>
          <strong class="desk-item-title"><%= row.title %></strong>
          <% if row.detail.present? %>
            <br><span class="text-meta text-ink-soft"><%= row.detail %></span>
          <% end %>
        </span>
        <span class="<%= row.blocked? ? "text-margem font-medium" : "text-meta text-ink-soft" %>"><%= row.stamp %></span>
      <% end %>
    <% end %>
  </nav>
</aside>

<article data-desk="in-work" class="min-h-0 overflow-auto px-8 pt-10 pb-16 md:px-10">
  <h1 class="text-display leading-[1.1] font-semibold tracking-[-0.02em]"><%= SetupDesk::TITLES.fetch(@setup_desk.selected) %></h1>
  <% if @setup_desk.selected == "archive" %>
    <p class="mt-1 text-meta text-ink-soft">Pasta do Google Drive onde o fechamento grava o mês.</p>
  <% end %>
  <%= render "shared/notice", message: (@accountant_error.presence || @certificate_error.presence).to_s %>
  <%= render "setup/#{@setup_desk.selected}" %>
</article>
