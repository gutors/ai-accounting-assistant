<%= form_with url: "/months/#{month.year_month}/bank_statements", method: :post, multipart: true, class: "grid gap-3 sm:grid-cols-2 sm:items-end" do %>
  <%= hidden_field_tag :bank_account_id, bank_account.id %>
  <div>
    <label for="pdf_<%= bank_account.id %>" class="mb-1 block font-medium">PDF</label>
    <%= file_field_tag :pdf, id: "pdf_#{bank_account.id}", class: "block w-full max-w-full text-meta" %>
  </div>
  <div>
    <label for="spreadsheet_<%= bank_account.id %>" class="mb-1 block font-medium">Planilha</label>
    <%= file_field_tag :spreadsheet, id: "spreadsheet_#{bank_account.id}", class: "block w-full max-w-full text-meta" %>
  </div>
  <div class="sm:col-span-2">
    <%= submit_tag "Enviar extrato", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
  </div>
<% end %>
