<% content_for :title, "#{@organization.name} — #{@month.year_month}" %>

<div class="flex items-start justify-between gap-4 mb-8">
  <h1 class="text-2xl font-semibold"><%= @month.year_month %></h1>
  <div class="flex items-center gap-4">
    <% if @month.closed? %>
      <p>Mês fechado</p>
      <%= button_to "Reabrir", "/months/#{@month.year_month}/reopen", method: :post, class: "rounded bg-zinc-900 text-white px-4 py-2" %>
    <% else %>
      <%= button_to "Fechar para envio", "/months/#{@month.year_month}/close", method: :post, class: "rounded bg-zinc-900 text-white px-4 py-2" %>
    <% end %>
    <%= link_to "Início", "/", class: "text-sm underline" %>
    <%= button_to "Sair", "/session", method: :delete, class: "text-sm underline" %>
  </div>
</div>

<% if @import_error.present? %>
  <p class="mb-6"><%= @import_error %></p>
<% end %>

<% if @month_error.present? %>
  <p class="mb-6"><%= @month_error %></p>
<% end %>

<section class="mb-10">
  <h2 class="text-lg font-medium mb-3">Contas bancárias</h2>
  <% if @active_bank_accounts.empty? %>
    <p class="mb-3">Nenhuma conta bancária ativa</p>
  <% else %>
    <ul>
      <% @active_bank_accounts.each do |bank_account| %>
        <% statement = @statements_by_account_id[bank_account.id] %>
        <li class="border rounded p-3 mb-3">
          <p class="font-medium"><%= bank_account.name %></p>
          <% if bank_account.coordinates.present? %>
            <p class="text-sm mb-2"><%= bank_account.coordinates %></p>
          <% end %>
          <% if statement %>
            <p>Presente</p>
            <p class="text-sm"><%= statement.pdf.filename %></p>
            <p class="text-sm mb-3"><%= statement.spreadsheet.filename %></p>
          <% else %>
            <p class="mb-3">Falta</p>
          <% end %>
          <% unless @month.closed? %>
            <%= form_with url: "/months/#{@month.year_month}/bank_statements", method: :post, multipart: true do %>
              <%= hidden_field_tag :bank_account_id, bank_account.id %>
              <label for="pdf_<%= bank_account.id %>" class="block mb-1">PDF</label>
              <%= file_field_tag :pdf, id: "pdf_#{bank_account.id}", class: "mb-3" %>
              <label for="spreadsheet_<%= bank_account.id %>" class="block mb-1">Planilha</label>
              <%= file_field_tag :spreadsheet, id: "spreadsheet_#{bank_account.id}", class: "mb-3" %>
              <%= submit_tag "Enviar extrato", class: "rounded bg-zinc-900 text-white px-4 py-2" %>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section class="mb-10">
  <h2 class="text-lg font-medium mb-3">Recebimentos</h2>
  <ul>
    <% @inflows.each do |inflow| %>
      <li class="mb-2">
        <time datetime="<%= inflow.occurred_on.iso8601 %>"><%= l(inflow.occurred_on) %></time>
        <%= format_reais(inflow.amount_cents) %>
        <%= inflow.bank_statement.bank_account.name %>
        <%= inflow.history %>
      </li>
    <% end %>
  </ul>
</section>

<section class="mb-10">
  <h2 class="text-lg font-medium mb-3">Pagamentos</h2>
  <ul>
    <% @payments.each do |payment| %>
      <li class="mb-2">
        <time datetime="<%= payment.occurred_on.iso8601 %>"><%= l(payment.occurred_on) %></time>
        <%= format_reais(payment.amount_cents) %>
        <%= payment.bank_statement.bank_account.name %>
        <%= payment.history %>
        <% if payment.missing_document? %>
          Documento faltante
          <% suggestion = @suggestions_by_payment_id[payment.id] %>
          <% exception_suggestion = @exception_suggestions_by_payment_id[payment.id] %>
          <% if suggestion %>
            Sugestão
            <% suggestion.supporting_documents.each do |document| %>
              <%= document.payee %>
            <% end %>
          <% elsif exception_suggestion %>
            Sugestão de exceção
          <% end %>
          <% unless @month.closed? %>
            <%= form_with url: "/months/#{@month.year_month}/matches", method: :post do %>
              <%= hidden_field_tag "payment_ids[]", payment.id, id: "payment_ids_#{payment.id}" %>
              <% suggested_ids = suggestion&.one_to_one_form_document_ids || [] %>
              <% @unmatched_documents.each do |document| %>
                <%= check_box_tag "supporting_document_ids[]", document.id, suggested_ids.include?(document.id), id: "doc_#{payment.id}_#{document.id}" %>
                <label for="doc_<%= payment.id %>_<%= document.id %>"><%= document.payee %></label>
              <% end %>
              <label for="observation_<%= payment.id %>" class="block mb-1">Observação do casamento</label>
              <%= text_area_tag :observation, nil, id: "observation_#{payment.id}", class: "border rounded px-2 py-1 mb-3 w-full max-w-md", rows: 2 %>
              <%= submit_tag "Confirmar casamento", class: "rounded bg-zinc-900 text-white px-4 py-2" %>
            <% end %>
            <%= form_with url: "/months/#{@month.year_month}/payments/#{payment.id}/document_exception", method: :post do %>
              <%= hidden_field_tag :kind, "bank_fee", id: "kind_bank_#{payment.id}" %>
              <%= submit_tag "Marcar tarifa", class: "rounded bg-zinc-900 text-white px-4 py-2" %>
            <% end %>
            <%= form_with url: "/months/#{@month.year_month}/payments/#{payment.id}/document_exception", method: :post do %>
              <%= hidden_field_tag :kind, "accountant_fee", id: "kind_accountant_#{payment.id}" %>
              <%= submit_tag "Marcar honorário", class: "rounded bg-zinc-900 text-white px-4 py-2" %>
            <% end %>
            <% @active_extra_exception_kinds.each do |extra_exception_kind| %>
              <%= form_with url: "/months/#{@month.year_month}/payments/#{payment.id}/document_exception", method: :post do %>
                <%= hidden_field_tag :extra_exception_kind_id, extra_exception_kind.id, id: "extra_kind_#{payment.id}_#{extra_exception_kind.id}" %>
                <%= submit_tag extra_exception_kind.name, class: "rounded bg-zinc-900 text-white px-4 py-2" %>
              <% end %>
            <% end %>
          <% end %>
        <% elsif payment.match_id.present? %>
          Casado
          <% payment.match.supporting_documents.each do |document| %>
            <%= document.payee %>
          <% end %>
          <% if payment.match.observation.present? %>
            <%= payment.match.observation %>
          <% end %>
          <% unless @month.closed? %>
            <%= button_to "Desfazer casamento", "/months/#{@month.year_month}/matches/#{payment.match_id}", method: :delete, class: "text-sm underline" %>
          <% end %>
        <% elsif payment.bank_fee? %>
          Tarifa bancária
          <% unless @month.closed? %>
            <%= button_to "Desmarcar exceção", "/months/#{@month.year_month}/payments/#{payment.id}/document_exception", method: :delete, class: "text-sm underline" %>
          <% end %>
        <% elsif payment.accountant_fee? %>
          Honorário do contador
          <% unless @month.closed? %>
            <%= button_to "Desmarcar exceção", "/months/#{@month.year_month}/payments/#{payment.id}/document_exception", method: :delete, class: "text-sm underline" %>
          <% end %>
        <% elsif payment.extra_exception_kind_id.present? %>
          <%= payment.extra_exception_kind.name %>
          <% unless @month.closed? %>
            <%= button_to "Desmarcar exceção", "/months/#{@month.year_month}/payments/#{payment.id}/document_exception", method: :delete, class: "text-sm underline" %>
          <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <% if !@month.closed? && @missing_document_payments.size >= 2 && @unmatched_documents.any? %>
    <%= form_with url: "/months/#{@month.year_month}/matches", method: :post do %>
      <% @missing_document_payments.each do |payment| %>
        <%= check_box_tag "payment_ids[]", payment.id, @format_2_suggestion&.covers_payment?(payment), id: "n1_pay_#{payment.id}" %>
        <label for="n1_pay_<%= payment.id %>"><%= format_reais(payment.amount_cents) %></label>
      <% end %>
      <% @unmatched_documents.each do |document| %>
        <%= radio_button_tag "supporting_document_ids[]", document.id, @format_2_suggestion&.suggested_document?(document), id: "n1_doc_#{document.id}" %>
        <label for="n1_doc_<%= document.id %>"><%= document.payee %></label>
      <% end %>
      <label for="observation_n1" class="block mb-1">Observação do casamento</label>
      <%= text_area_tag :observation, nil, id: "observation_n1", class: "border rounded px-2 py-1 mb-3 w-full max-w-md", rows: 2 %>
      <%= submit_tag "Confirmar casamento N:1", class: "rounded bg-zinc-900 text-white px-4 py-2" %>
    <% end %>
  <% end %>
</section>

<section class="mb-10">
  <h2 class="text-lg font-medium mb-3">Documentos sem casamento</h2>
  <% if @unmatched_documents.empty? %>
    <p>Nenhum documento sem casamento</p>
  <% else %>
    <ul>
      <% @unmatched_documents.each do |document| %>
        <li class="mb-2">
          <%= document.payee %>
          <%= format_reais(document.amount_cents) %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
