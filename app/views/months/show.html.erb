<% content_for :title, "#{@organization.name} — #{@month.year_month}" %>
<% movements_visible = @month.accounts_confirmed? || @month.closed? %>
<% missing_count = @missing_document_payments.size %>
<% accounts_without_statement = @active_bank_accounts.count { |bank_account| @statements_by_account_id[bank_account.id].nil? } %>
<% casar_href = "/months/#{@month.year_month}/matches" %>
<% casar_href += "?bank_account_id=#{@bank_account_id}" if @bank_account_id %>

<p>
  <%= link_to "Voltar para Início", "/", class: "text-caixa underline underline-offset-2" %>
</p>

<div class="mt-6 flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
  <div>
    <h1 class="text-[1.75rem] leading-[1.1] font-semibold tracking-[-0.02em] md:text-display"><%= month_title(@month.year_month) %></h1>
    <p class="mt-1 text-meta text-ink-soft"><%= @month.year_month %></p>
    <% if @month.closed? %>
      <span data-stamp="closed" class="stamp-closed">Mês fechado</span>
    <% end %>
  </div>
  <div class="flex flex-wrap items-center gap-3">
    <% if movements_visible && !@month.closed? %>
      <%= link_to "Casar pagamentos", casar_href, class: "ds-btn-secondary" %>
    <% end %>
    <% month_post_params = @bank_account_id ? { bank_account_id: @bank_account_id } : {} %>
    <% if @month.closed? %>
      <%= button_to "Restaurar pasta", "/months/#{@month.year_month}/restore", method: :post, params: month_post_params, form: { data: { turbo_confirm: "Restaurar a pasta do mês no arquivo do pacote?" } }, class: "ds-btn-secondary" %>
      <%= button_to "Reabrir", "/months/#{@month.year_month}/reopen", method: :post, params: month_post_params, form: { data: { turbo_confirm: "Reabrir o mês?" } }, class: "ds-btn-secondary" %>
    <% else %>
      <%= form_with url: "/months/#{@month.year_month}/close", method: :post, html: { id: "close-month", data: { turbo_confirm: "Fechar o mês para envio?" } } do %>
        <% if @bank_account_id %>
          <%= hidden_field_tag :bank_account_id, @bank_account_id %>
        <% end %>
        <%= submit_tag "Fechar para envio", class: "ds-btn-primary" %>
      <% end %>
    <% end %>
  </div>
</div>

<p class="mt-6">
  <% if movements_visible %>
    <% if missing_count.zero? %>
      <span>Nenhum documento faltante.</span>
    <% else %>
      <span class="text-margem"><%= missing_count %> <%= missing_count == 1 ? "pagamento" : "pagamentos" %> com documento faltante.</span>
    <% end %>
    <% if accounts_without_statement.positive? %>
      <span>Falta o extrato de <%= accounts_without_statement %> <%= accounts_without_statement == 1 ? "conta ativa" : "contas ativas" %>.</span>
    <% end %>
  <% else %>
    <span>Insira os extratos das contas bancárias com as quais deseja realizar o fechamento.</span>
  <% end %>
</p>

<% if @import_error.present? %>
  <%= render "shared/notice", message: @import_error %>
<% end %>

<% if @month_error.present? %>
  <%= render "shared/notice", message: @month_error %>
<% end %>

<div class="mt-10 space-y-12">
  <section>
    <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Contas bancárias</h2>
    <% if @active_bank_accounts.empty? %>
      <p>Nenhuma conta bancária ativa</p>
    <% else %>
      <div class="ledger-sheet">
        <div class="ledger-row ledger-head ledger-month-bank" aria-hidden="true">
          <span>Banco</span>
          <span>Nome</span>
          <span>Agência/conta</span>
          <span>Situação</span>
          <span>Documentos</span>
          <span></span>
        </div>
        <ul>
          <% @active_bank_accounts.each do |bank_account| %>
            <% statement = @statements_by_account_id[bank_account.id] %>
            <li data-row="bank-account" data-bank-account-id="<%= bank_account.id %>" class="ledger-row ledger-month-bank">
              <p class="font-medium"><%= bank_account.bank.presentation_name %></p>
              <p class="font-medium"><%= bank_account.name %></p>
              <p class="text-meta text-ink-soft"><%= bank_account.coordinates %></p>
              <div data-cell="situation">
                <% if statement %>
                  <p>Presente</p>
                <% else %>
                  <p class="text-margem">Falta</p>
                <% end %>
              </div>
              <div data-cell="documents">
                <% if statement&.pdf&.attached? %>
                  <% pdf_line = "Pdf #{statement.pdf.filename}" %>
                  <p class="truncate text-meta text-ink-soft" title="<%= pdf_line %>"><%= pdf_line %></p>
                <% end %>
                <% if statement&.spreadsheet&.attached? %>
                  <% spreadsheet_line = "Planilha #{statement.spreadsheet.filename}" %>
                  <p class="truncate text-meta text-ink-soft" title="<%= spreadsheet_line %>"><%= spreadsheet_line %></p>
                <% end %>
              </div>
              <div>
                <% unless @month.closed? %>
                  <%= tag.details open: @import_bank_account_id.to_s == bank_account.id.to_s do %>
                    <summary class="cursor-pointer font-medium text-caixa"><%= statement ? "Substituir extrato" : "Incluir extrato" %></summary>
                    <div class="mt-3 rounded border border-rule bg-sheet p-4">
                      <%= render "months/statement_form", month: @month, bank_account: bank_account %>
                    </div>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </section>

  <% unless movements_visible %>
    <section id="confirm-step">
      <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Confirmar contas para fechamento</h2>
      <% unless @active_bank_accounts.empty? %>
        <div class="ledger-sheet">
          <div class="ledger-row ledger-head ledger-confirm" aria-hidden="true">
            <span>Nome</span>
            <span>Situação</span>
          </div>
          <ul>
            <% @active_bank_accounts.each do |bank_account| %>
              <% statement = @statements_by_account_id[bank_account.id] %>
              <li class="ledger-row ledger-confirm">
                <p class="font-medium"><%= bank_account.name %></p>
                <% if statement %>
                  <p>Presente</p>
                <% else %>
                  <p class="text-margem">Falta</p>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
      <%= form_with url: "/months/#{@month.year_month}/account_confirmation", method: :post, html: { class: "mt-4" } do %>
        <%= submit_tag "Iniciar fechamento", class: "rounded bg-caixa px-4 py-2 font-semibold text-white", disabled: !@month.spreadsheet_present? %>
      <% end %>
    </section>
  <% end %>

  <% if movements_visible %>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Conta bancária">
      <% if @bank_account_id.nil? %>
        <%= link_to "Todas", "/months/#{@month.year_month}", aria: { current: "true" }, class: "rounded bg-caixa px-3 py-1 font-semibold text-white" %>
      <% else %>
        <%= link_to "Todas", "/months/#{@month.year_month}", class: "rounded border border-ink px-3 py-1" %>
      <% end %>
      <% @active_bank_accounts.each do |bank_account| %>
        <% if @bank_account_id == bank_account.id %>
          <%= link_to bank_account.name, "/months/#{@month.year_month}?bank_account_id=#{bank_account.id}", aria: { current: "true" }, class: "rounded bg-caixa px-3 py-1 font-semibold text-white" %>
        <% else %>
          <%= link_to bank_account.name, "/months/#{@month.year_month}?bank_account_id=#{bank_account.id}", class: "rounded border border-ink px-3 py-1" %>
        <% end %>
      <% end %>
    </div>

    <details class="month-fold" open>
      <summary>Pagamentos</summary>
      <div class="ledger-sheet">
        <div class="ledger-row ledger-head ledger-pay ledger-overview-pay">
          <span class="sort-key">Data</span>
          <span>Histórico</span>
          <span class="ledger-amount">Valor</span>
          <span>Status</span>
          <span>Documento</span>
        </div>
        <ul>
          <% @payments.each do |payment| %>
            <% status = payment_status(payment) %>
            <% suggestion = @suggestions_by_payment_id[payment.id] %>
            <% exception_suggestion = @exception_suggestions_by_payment_id[payment.id] %>
            <li data-row="payment" data-payment-id="<%= payment.id %>" data-status="<%= status %>" class="ledger-row ledger-pay ledger-overview-pay<%= " is-block" if status == "missing" %>">
              <time datetime="<%= payment.occurred_on.iso8601 %>" class="tabular-nums"><%= l(payment.occurred_on) %></time>
              <div>
                <p class="font-medium"><%= payment.history %></p>
                <p class="text-meta text-ink-soft"><%= payment.bank_statement.bank_account.name %></p>
              </div>
              <p data-cell="amount" class="font-medium tabular-nums"><%= format_reais(payment.amount_cents) %></p>
              <div data-cell="status">
                <% if status == "missing" %>
                  <p class="font-medium text-margem">Documento faltante</p>
                  <% if suggestion %>
                    <p class="text-meta text-ink-soft">Sugestão <%= suggestion.supporting_documents.map(&:payee).join(", ") %></p>
                  <% elsif exception_suggestion %>
                    <p class="text-meta text-ink-soft">Sugestão de exceção</p>
                  <% end %>
                <% elsif status == "matched" %>
                  <p class="font-medium">Casado</p>
                  <% if payment.match.observation.present? %>
                    <p class="text-meta text-ink-soft"><%= payment.match.observation %></p>
                  <% end %>
                <% elsif status == "bank_fee" %>
                  <p class="font-medium">Tarifa bancária</p>
                <% elsif status == "accountant_fee" %>
                  <p class="font-medium">Honorário do contador</p>
                <% elsif status == "extra" %>
                  <p class="font-medium"><%= payment.extra_exception_kind.name %></p>
                <% end %>
              </div>
              <p data-cell="document" class="font-medium">
                <% if status == "matched" %>
                  <%= payment.match.supporting_documents.map(&:payee).join(", ") %>
                <% end %>
              </p>
            </li>
          <% end %>
        </ul>
      </div>
    </details>

    <details class="month-fold" open>
      <summary>Documentos sem casamento</summary>
      <% if @unmatched_documents.empty? %>
        <p>Nenhum documento sem casamento</p>
      <% else %>
        <div class="ledger-sheet">
          <div class="ledger-row ledger-head ledger-overview-pool" aria-hidden="true">
            <span>Data</span>
            <span>Favorecido</span>
            <span>Tipo</span>
            <span class="ledger-amount">Valor</span>
            <span>Foto</span>
            <span></span>
          </div>
          <ul>
            <% @unmatched_documents.each do |document| %>
              <li data-row="pool-document" data-document-id="<%= document.id %>" class="ledger-row ledger-overview-pool">
                <time datetime="<%= document.document_on.iso8601 %>" class="tabular-nums"><%= l(document.document_on) %></time>
                <div class="flex items-center gap-2 font-medium">
                  <% if !@month.closed? && document.month_id.nil? %>
                    <%= check_box_tag "supporting_document_ids[]", document.id, false, id: "close_doc_#{document.id}", form: "close-month" %>
                    <label for="close_doc_<%= document.id %>"><%= document.payee %></label>
                  <% else %>
                    <%= document.payee %>
                  <% end %>
                </div>
                <p><%= document.recibo? ? "Recibo" : "Nota fiscal" %></p>
                <p data-cell="amount" class="font-medium tabular-nums"><%= format_reais(document.amount_cents) %></p>
                <div data-cell="photo" class="min-w-0 truncate text-meta">
                  <% if document.photo.attached? %>
                    <%= link_to document.photo.filename, url_for(document.photo), class: "text-caixa underline underline-offset-2" %>
                  <% end %>
                </div>
                <div>
                  <% if !@month.closed? && document.month_id == @month.id %>
                    <%= button_to "Devolver", "/months/#{@month.year_month}/supporting_documents/#{document.id}/return", method: :post, class: "text-margem underline underline-offset-2" %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </details>

    <details class="month-fold" open>
      <summary>Recebimentos</summary>
      <div class="ledger-sheet">
        <div class="ledger-row ledger-head ledger-inflow" aria-hidden="true">
          <span>Data</span>
          <span>Histórico</span>
          <span class="ledger-amount">Valor</span>
        </div>
        <ul>
          <% @inflows.each do |inflow| %>
            <li data-row="inflow" class="ledger-row ledger-inflow">
              <time datetime="<%= inflow.occurred_on.iso8601 %>" class="tabular-nums"><%= l(inflow.occurred_on) %></time>
              <div>
                <p class="font-medium"><%= inflow.history %></p>
                <p class="text-meta text-ink-soft"><%= inflow.bank_statement.bank_account.name %></p>
              </div>
              <p data-cell="amount" class="font-medium tabular-nums"><%= format_reais(inflow.amount_cents) %></p>
            </li>
          <% end %>
        </ul>
      </div>
    </details>
  <% end %>
</div>
