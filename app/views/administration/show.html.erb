<div>
  <div class="flex flex-wrap items-start justify-between gap-x-8 gap-y-4">
    <h1 class="text-2xl leading-7 font-semibold tracking-[-0.01em]">Administração</h1>
    <%= link_to "Adicionar organização", new_administration_path, class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
  </div>

  <% @notices.each do |message| %>
    <%= render "shared/notice", message: message %>
  <% end %>

  <% if @organizations.any? %>
  <div class="ledger-sheet mt-10">
      <div class="ledger-row ledger-head ledger-org">
        <p>Nome</p>
        <p>Email coordenador</p>
        <p>Status</p>
        <p>Editar</p>
      </div>
      <% @organizations.each do |organization| %>
        <%= render "administration/organization_row", organization: organization %>
      <% end %>
    </div>
  <% else %>
    <p class="mt-10">Nenhuma organização cadastrada.</p>
  <% end %>
</div>
