<div data-organization-id="<%= organization.id %>" class="border-b border-rule py-3">
  <div class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 gap-y-1 md:grid-cols-[minmax(0,1.2fr)_minmax(0,1.4fr)_7rem_4.5rem]">
    <p class="font-medium"><%= organization.name %></p>
    <p class="min-w-0 break-all md:col-start-2"><%= organization.listed_coordinator_account&.email %></p>
    <p class="text-ink-soft md:col-start-3"><%= organization.listed_coordinator_signed_in? ? "Ativa" : "Pendente" %></p>
    <%= link_to "Editar", edit_administration_path(organization), class: "col-start-2 row-start-1 text-caixa underline underline-offset-2 md:col-start-4 md:row-start-1" %>
  </div>
  <%= render "administration/mail_result", organization: organization %>
</div>
