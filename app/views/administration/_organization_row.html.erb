<div data-organization-id="<%= organization.id %>">
  <div class="ledger-row ledger-org">
    <p class="font-medium"><%= organization.name %></p>
    <p class="min-w-0 break-all"><%= organization.listed_coordinator_account&.email %></p>
    <p class="text-ink-soft"><%= organization.listed_coordinator_signed_in? ? "Ativa" : "Pendente" %></p>
    <%= link_to "Editar", edit_administration_path(organization), class: "text-caixa underline underline-offset-2" %>
  </div>
  <%= render "administration/mail_result", organization: organization %>
</div>
