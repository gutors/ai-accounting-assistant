<% principal_email = organization.listed_coordinator_account&.email %>
<% peer_emails = organization.coordinator_emails.reject { |email| email == principal_email } %>
<div data-organization-id="<%= organization.id %>" class="mt-6">
  <% if @name_organization&.id == organization.id && @name_phase == :confirm %>
    <div>
      <p class="font-medium">Nome da organização</p>
      <p><%= @name_value %></p>
      <p>Nenhum e-mail será enviado.</p>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= button_to "Confirmar", "/administration/name/confirm", method: :post, params: { organization_id: organization.id }, class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      <%= button_to "Corrigir", "/administration/correct", method: :post, class: "ds-btn-secondary" %>
    </div>
  <% elsif @name_organization&.id == organization.id && @name_phase == :field %>
    <%= form_with url: "/administration/name/continue", method: :post, id: "name_correction_form" do %>
      <%= label_tag "name_correction", "Nome da organização", class: "block font-medium" %>
      <%= text_field_tag :name, @name_value, id: "name_correction", class: "mt-1 w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "organization" %>
    <% end %>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= submit_tag "Continuar", form: "name_correction_form", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      <%= button_to "Cancelar", "/administration/name/cancel", method: :post, class: "text-caixa underline underline-offset-2" %>
    </div>
    <% if principal_email %>
      <div class="border-b border-rule pb-2 mb-2 mt-6">
        <p class="font-medium">E-mail do coordenador principal</p>
      </div>
      <p class="mt-2"><%= principal_email %></p>
    <% end %>
    <% if peer_emails.any? %>
      <div class="border-b border-rule pb-2 mb-2 mt-6">
        <p class="font-medium">Outros coordenadores</p>
      </div>
      <% peer_emails.each do |email| %>
        <p class="mt-2"><%= email %></p>
      <% end %>
    <% end %>
  <% elsif @email_organization&.id == organization.id && @email_phase == :confirm %>
    <div class="border-b border-rule pb-4">
      <p class="font-medium">Nome da organização</p>
      <p><%= organization.name %></p>
    </div>
    <div class="mt-4">
      <p class="font-medium">E-mail do coordenador principal</p>
      <p><%= @email_value %></p>
    </div>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= button_to "Confirmar", "/administration/email/confirm", method: :post, params: { organization_id: organization.id }, class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      <%= button_to "Corrigir", "/administration/correct", method: :post, class: "ds-btn-secondary" %>
    </div>
  <% elsif @email_organization&.id == organization.id && @email_phase == :field %>
    <div class="border-b border-rule pb-2 mb-2">
      <p class="font-medium">Nome da organização</p>
    </div>
    <p class="mt-2"><%= organization.name %></p>
    <%= form_with url: "/administration/email/continue", method: :post, id: "email_correction_form", class: "mt-4" do %>
      <%= label_tag "email_correction", "E-mail do coordenador principal", class: "block font-medium" %>
      <%= email_field_tag :email, @email_value, id: "email_correction", class: "mt-1 w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "email" %>
    <% end %>
    <div class="mt-4 flex flex-wrap items-center gap-3">
      <%= submit_tag "Continuar", form: "email_correction_form", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      <%= button_to "Cancelar", "/administration/email/cancel", method: :post, class: "text-caixa underline underline-offset-2" %>
    </div>
    <% if peer_emails.any? %>
      <div class="border-b border-rule pb-2 mb-2 mt-6">
        <p class="font-medium">Outros coordenadores</p>
      </div>
      <% peer_emails.each do |email| %>
        <p class="mt-2"><%= email %></p>
      <% end %>
    <% end %>
  <% else %>
    <div class="border-b border-rule pb-2 mb-2">
      <p class="font-medium">Nome da organização</p>
    </div>
    <p class="mt-2"><%= organization.name %></p>
    <%= button_to "Corrigir nome", "/administration/name", method: :post, params: { organization_id: organization.id }, class: "text-caixa underline underline-offset-2" %>
    <div class="border-b border-rule pb-2 mb-2 mt-6">
      <p class="font-medium">E-mail do coordenador principal</p>
    </div>
    <% if principal_email %>
      <p class="mt-2"><%= principal_email %></p>
      <%= button_to "Corrigir", "/administration/email", method: :post, params: { organization_id: organization.id, email: principal_email }, class: "text-caixa underline underline-offset-2" %>
    <% end %>
    <% if peer_emails.any? %>
      <div class="border-b border-rule pb-2 mb-2 mt-6">
        <p class="font-medium">Outros coordenadores</p>
      </div>
      <% peer_emails.each do |email| %>
        <p class="mt-2"><%= email %></p>
      <% end %>
    <% end %>
    <%= button_to "Remover", "/administration", method: :delete, params: { organization_id: organization.id }, form: { data: { turbo_confirm: "Remover a organização #{organization.name}?" } }, class: "mt-4 text-margem underline underline-offset-2" %>
    <%= render "administration/mail_result", organization: organization %>
    <% if @removal_organization&.id == organization.id %>
      <div class="mt-4">
        <%= render "shared/notice", message: @removal_organization.errors[:base].first %>
      </div>
    <% end %>
  <% end %>
</div>
