<% content_for :title, @organization.name %>

<% if coordinator_on_focus? %>
  <% content_for :body_class, "flex h-dvh flex-col overflow-hidden" %>
  <% content_for :main_class, "desk grid min-h-0 flex-1 overflow-hidden md:grid-cols-[26rem_1fr]" %>

  <aside data-desk="index" class="flex min-h-0 flex-col overflow-hidden border-rule px-8 pt-10 md:border-r md:pr-6">
    <div class="desk-index-scroll">
      <%= form_with url: "/months", method: :post, class: "mb-7" do %>
        <label for="year_month" class="mb-2 block border-b border-rule pb-2 text-lg leading-6 font-semibold">Abrir mês</label>
        <div class="flex flex-nowrap items-stretch gap-2">
          <%= select_tag :year_month, options_for_select(openable_month_options, previous_calendar_year_month), id: "year_month", class: "min-w-0 flex-1 rounded border border-rule bg-sheet px-3 py-2" %>
          <%= submit_tag "Abrir mês", class: "ds-btn-primary shrink-0 whitespace-nowrap" %>
        </div>
      <% end %>

      <% if @month_error.present? %>
        <%= render "shared/notice", message: @month_error %>
      <% end %>

      <h2 class="mb-2 border-b border-rule pb-2 text-lg leading-6 font-semibold">Meses</h2>
      <% if @months.empty? %>
        <p>Nenhum mês aberto</p>
      <% else %>
        <ul class="desk-month-list">
          <% @months.each do |month| %>
            <% live = @in_work_month&.id == month.id %>
            <% selected = !@people_desk && @selected_month&.id == month.id %>
            <li data-row="month" class="desk-month<%= " is-live" if live %>">
              <%= link_to root_path(year_month: month.year_month), class: "desk-month-link", aria: { current: ("true" if selected) } do %>
                <span>
                  <strong class="desk-month-title"><%= month_title(month.year_month) %></strong>
                  <% if live %>
                    <br><span class="desk-month-now">em trabalho</span>
                  <% end %>
                </span>
                <% if month.closed? %>
                  <span class="stamp-closed-row">Fechado</span>
                <% else %>
                  <span class="text-meta text-ink-soft">Aberto</span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <%= render "organizations/people_pin" %>
  </aside>

  <article data-desk="in-work" class="min-h-0 overflow-auto px-8 pt-10 pb-16 md:px-10">
    <% if @people_desk %>
      <%= render "organizations/people_book" %>
    <% elsif @selected_month %>
      <%= render "organizations/month_desk" %>
    <% else %>
      <p>Selecione um mês na lista.</p>
    <% end %>
  </article>
<% else %>
  <h1 class="text-2xl leading-7 font-semibold tracking-[-0.01em]">Início</h1>
  <p class="mt-4">Inclua e acompanhe seus documentos de suporte em <%= link_to "Documentos", "/supporting_documents", class: "text-caixa underline underline-offset-2" %>.</p>
<% end %>
