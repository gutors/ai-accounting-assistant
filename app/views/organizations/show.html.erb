<% content_for :title, @organization.name %>

<nav aria-label="Organizações" class="mb-12">
  <p class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Organizações</p>
  <% if @focusable_organizations.size > 1 %>
    <ul class="flex flex-wrap gap-2">
      <% @focusable_organizations.each do |organization| %>
        <% focused = organization.id == @organization.id %>
        <li>
          <%= button_to organization.name, "/focus", params: { organization_id: organization.id }, aria: { current: focused ? "true" : nil }, class: focused ? "rounded bg-caixa px-3 py-1 font-semibold text-white" : "rounded border border-ink px-3 py-1 text-ink" %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="font-medium"><%= @organization.name %></p>
  <% end %>
</nav>

<% if coordinator_on_focus? %>
  <h1 class="text-2xl leading-7 font-semibold tracking-[-0.01em]">Início</h1>
  <p class="mt-4 max-w-prose">Selecione um mês para abrir o fechamento ou escolha um na lista abaixo.</p>
  <% if @month_error.present? %>
    <%= render "shared/notice", message: @month_error %>
  <% end %>

  <div class="mt-12 space-y-12">
    <section>
      <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Abrir o fechamento mensal</h2>
      <%= form_with url: "/months", method: :post, class: "flex flex-wrap items-end gap-3" do %>
        <div>
          <label for="year_month" class="mb-1 block font-medium">Mês</label>
          <%= select_tag :year_month, options_for_select(openable_month_options, previous_calendar_year_month), id: "year_month", class: "rounded border border-rule bg-sheet px-3 py-2" %>
        </div>
        <%= submit_tag "Abrir mês", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      <% end %>
    </section>

    <section>
      <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Meses</h2>
      <% if @months.empty? %>
        <p>Nenhum mês aberto</p>
      <% else %>
        <div class="hidden border-b border-rule py-2 font-medium text-ink-soft md:grid md:grid-cols-[minmax(0,1fr)_8rem_8rem] md:gap-x-4">
          <span>Mês</span>
          <span>AAAA-MM</span>
          <span class="text-right">Status</span>
        </div>
        <ul>
          <% @months.each do |month| %>
            <li data-row="month" class="grid grid-cols-1 gap-x-4 gap-y-1 border-b border-rule py-3 md:grid-cols-[minmax(0,1fr)_8rem_8rem]">
              <%= link_to month_title(month.year_month), "/months/#{month.year_month}", class: "font-medium text-caixa underline underline-offset-2" %>
              <span class="text-meta text-ink-soft tabular-nums"><%= month.year_month %></span>
              <span class="text-ink-soft md:text-right"><%= month.closed? ? "Fechado" : "Aberto" %></span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>

    <section>
      <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Pessoas</h2>
      <div class="grid gap-x-8 gap-y-10 md:grid-cols-2">
        <div>
          <h3 class="mb-2 font-medium">Coordenadores</h3>
          <ul>
            <% @coordinator_accesses.each do |access| %>
              <li class="flex items-center justify-between gap-3 border-b border-rule py-2">
                <span class="min-w-0 break-all"><%= access.account.email %></span>
                <% if @organization.principal_coordinator_account_id == current_account.id && access.account_id != current_account.id %>
                  <%= button_to "Revogar", "/accesses/#{access.id}", method: :delete, form: { data: { turbo_confirm: "Revogar o acesso deste coordenador?" } }, class: "text-margem underline underline-offset-2" %>
                <% end %>
              </li>
            <% end %>
          </ul>
          <%= form_with url: "/coordinator_invites", method: :post, class: "mt-4" do %>
            <fieldset>
              <legend class="mb-2 font-medium">Convidar coordenador</legend>
              <label for="email" class="mb-1 block">E-mail</label>
              <div class="flex flex-wrap gap-2">
                <%= email_field_tag :email, nil, id: "email", class: "min-w-0 grow rounded border border-rule bg-sheet px-3 py-2", autocomplete: "email" %>
                <%= submit_tag "Convidar", class: "rounded border border-ink px-4 py-2 text-ink" %>
              </div>
            </fieldset>
          <% end %>
        </div>

        <div>
          <h3 class="mb-2 font-medium">Submitters</h3>
          <ul>
            <% @submitter_accesses.each do |access| %>
              <li class="flex items-center justify-between gap-3 border-b border-rule py-2">
                <span class="min-w-0 break-all"><%= access.account.email %></span>
                <%= button_to "Revogar", "/accesses/#{access.id}", method: :delete, form: { data: { turbo_confirm: "Revogar o acesso deste submitter?" } }, class: "text-margem underline underline-offset-2" %>
              </li>
            <% end %>
          </ul>
          <%= form_with url: "/submitter_invites", method: :post, class: "mt-4" do %>
            <fieldset>
              <legend class="mb-2 font-medium">Convidar submitter</legend>
              <label for="submitter_email" class="mb-1 block">E-mail</label>
              <div class="flex flex-wrap gap-2">
                <%= email_field_tag :email, nil, id: "submitter_email", class: "min-w-0 grow rounded border border-rule bg-sheet px-3 py-2", autocomplete: "email" %>
                <%= submit_tag "Convidar", class: "rounded border border-ink px-4 py-2 text-ink" %>
              </div>
            </fieldset>
          <% end %>
        </div>
      </div>
    </section>

    <section>
      <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Convites pendentes</h2>
      <% if @invites.any? %>
        <div class="hidden border-b border-rule py-2 font-medium text-ink-soft md:grid md:grid-cols-[minmax(0,1.5fr)_9rem_minmax(10rem,1fr)_12rem] md:gap-x-4">
          <span>E-mail</span>
          <span>Tipo</span>
          <span>Status</span>
          <span></span>
        </div>
        <ul>
          <% @invites.each do |invite| %>
            <li data-row="invite" class="grid grid-cols-2 gap-x-4 gap-y-1 border-b border-rule py-3 md:grid-cols-[minmax(0,1.5fr)_9rem_minmax(10rem,1fr)_12rem]">
              <span class="col-span-2 min-w-0 break-all md:col-span-1"><%= invite.email %></span>
              <span><%= invite.coordinator? ? "Coordenador" : "Submitter" %></span>
              <span class="text-ink-soft"><%= invite.sent? ? "enviado" : "falhou envio do e-mail" %></span>
              <span class="col-span-2 flex flex-wrap items-center gap-3 md:col-span-1 md:justify-end">
                <%= button_to "Reenviar e-mail", "/#{invite.submitter? ? "submitter" : "coordinator"}_invites/#{invite.id}/mail", method: :post, class: "text-caixa underline underline-offset-2" %>
                <% if invite.submitter? %>
                  <%= button_to "Cancelar", "/submitter_invites/#{invite.id}", method: :delete, class: "text-margem underline underline-offset-2" %>
                <% else %>
                  <%= button_to "Cancelar", "/coordinator_invites/#{invite.id}", method: :delete, class: "text-margem underline underline-offset-2" %>
                <% end %>
              </span>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </div>
<% else %>
  <h1 class="text-2xl leading-7 font-semibold tracking-[-0.01em]">Início</h1>
  <p class="mt-4">Inclua e acompanhe seus documentos de suporte em <%= link_to "Documentos", "/supporting_documents", class: "text-caixa underline underline-offset-2" %>.</p>
<% end %>
