<% content_for :main_class, "mx-auto mt-7 max-w-6xl px-5 pb-16 md:px-8" %>
<% content_for :title, "Casar pagamentos — #{@month.year_month}" %>
<% matches_query = { screen: "matches", bank_account_id: @bank_account_id }.compact %>
<div data-controller="month-match">
  <div class="flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-[1.75rem] leading-[1.1] font-semibold tracking-[-0.02em] md:text-display">Casar pagamentos</h1>
      <p class="mt-1 text-meta text-ink-soft"><%= month_title(@month.year_month) %> · <%= @month.year_month %></p>
    </div>
    <%= link_to "Voltar ao mês", "/months/#{@month.year_month}", class: "text-caixa underline underline-offset-2" %>
  </div>
  <p class="match-pending <%= "match-pending--missing" if @missing_document_payments.any? %>">
    <% if @missing_document_payments.empty? %>Nenhum pagamento com documento faltante.<% else %><%= @missing_document_payments.size %> <%= @missing_document_payments.one? ? "pagamento" : "pagamentos" %> com documento faltante.<% end %>
  </p>
  <p role="alert" data-notice="error" tabindex="-1" data-month-match-target="error" class="match-error" <%= "hidden" if @month_error.blank? %>><%= @month_error %></p>
  <%= form_with url: "/months/#{@month.year_month}/matches", method: :get, class: "month-account-filter", data: { controller: "list-refresh" } do %>
    <div class="month-account-filter-row">
      <%= label_tag "match-account-select", "Filtrar por conta bancária", class: "font-semibold" %>
      <%= select_tag :bank_account_id, options_for_select([ [ "Todas as contas", "" ] ] + @active_bank_accounts.map { |account| [ account.name, account.id ] }, @bank_account_id || ""), id: "match-account-select", aria: { describedby: "match-account-filter-scope" }, data: { action: "change->list-refresh#submit" } %>
    </div>
    <p id="match-account-filter-scope" class="mt-1 text-meta text-ink-soft">Aplica-se aos pagamentos, casamentos e exceções.</p>
  <% end %>
  <% if !@month.closed? && @next_suggestion_payment %>
    <%= render "matches/workspace" %>
  <% end %>
  <%= render "matches/completed", matches_query: matches_query %>
</div>
