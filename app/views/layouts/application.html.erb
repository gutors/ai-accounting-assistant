<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Fechamento mensal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Fechamento mensal">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-full bg-paper text-ink antialiased">
    <%= render "layouts/header" %>
    <% if flash[:toast].present? %>
      <%= render "shared/toast" %>
    <% else %>
      <div data-toast-kind="error" hidden></div>
    <% end %>
    <main class="mx-auto mt-10 max-w-6xl px-5 pb-16 md:px-8">
      <%= yield %>
    </main>
  </body>
</html>
