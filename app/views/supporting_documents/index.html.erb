<% content_for :title, "Documentos de suporte" %>

<h1 class="text-2xl leading-7 font-semibold tracking-[-0.01em]">Documentos de suporte</h1>

<%= render "shared/notice", message: @document_error.to_s %>

<div class="mt-10 space-y-12">
  <% if coordinator_on_focus? %>
    <%= render "supporting_documents/insert_lote" %>
  <% else %>
    <section>
      <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Incluir documento</h2>
      <%= form_with url: "/supporting_documents", method: :post, multipart: true, class: "mt-4 grid items-start gap-12 md:grid-cols-[minmax(0,1fr)_28rem] md:gap-8", data: { controller: "document-identify" } do %>
        <aside class="rounded border border-rule bg-sheet p-4">
          <%= file_field_tag :file, id: "file", accept: "image/*,.pdf,application/pdf,.xml,application/xml,text/xml", class: "sr-only", tabindex: -1, data: { document_identify_target: "input", action: "change->document-identify#identify" } %>
          <%= render "supporting_documents/insert_preview" %>
        </aside>
        <%= render "supporting_documents/insert_book" %>
      <% end %>
    </section>
  <% end %>

  <section>
    <%= render "supporting_documents/sem_mes" %>
  </section>

  <section>
    <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Justificativas</h2>
    <% if @justifications.empty? %>
      <p class="mb-4">Nenhuma justificativa</p>
    <% else %>
      <div class="ledger-sheet mb-6">
        <div class="ledger-row ledger-head ledger-justification" aria-hidden="true">
          <span class="ledger-amount">Valor</span>
          <span>Favorecido</span>
        </div>
        <ul>
        <% @justifications.each do |justification| %>
          <li data-row="justification" data-justification-id="<%= justification.id %>" class="ledger-row ledger-justification">
            <p data-cell="amount" class="font-medium tabular-nums"><%= format_reais(justification.amount_cents) %></p>
            <div class="min-w-0">
              <p><%= justification.supporting_documents.map(&:payee).join(", ") %></p>
              <% if !coordinator_on_focus? && justification.supporting_documents.all? { |document| document.month_id.nil? } %>
                <details class="mt-1">
                  <summary class="cursor-pointer font-medium text-caixa">Editar</summary>
                  <%= form_with url: "/justifications/#{justification.id}", method: :patch, class: "mt-3 flex max-w-md flex-wrap items-end gap-3 rounded border border-rule bg-sheet p-4" do %>
                    <div class="min-w-0 grow">
                      <label for="justification_amount_<%= justification.id %>" class="mb-1 block font-medium">Valor gasto</label>
                      <%= text_field_tag :amount, format_reais(justification.amount_cents).delete_prefix("R$ ").strip, id: "justification_amount_#{justification.id}", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off", inputmode: "numeric", data: { controller: "money-mask", action: "input->money-mask#typed" } %>
                    </div>
                    <%= submit_tag "Salvar justificativa", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
                  <% end %>
                </details>
              <% end %>
            </div>
          </li>
        <% end %>
        </ul>
      </div>
    <% end %>

    <% unless coordinator_on_focus? %>
      <%= form_with url: "/justifications", method: :post, class: "max-w-3xl space-y-4" do %>
        <div class="max-w-md">
          <label for="justification_amount" class="mb-1 block font-medium">Valor gasto</label>
          <%= text_field_tag :amount, "0,00", id: "justification_amount", class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off", inputmode: "numeric", data: { controller: "money-mask", action: "input->money-mask#typed" } %>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-2">
          <% @documents.select { |document| document.month_id.nil? && document.justification_id.nil? }.each do |document| %>
            <label for="supporting_document_<%= document.id %>" class="inline-flex items-center gap-2">
              <%= check_box_tag "supporting_document_ids[]", document.id, false, id: "supporting_document_#{document.id}" %>
              <%= document.payee %>
            </label>
          <% end %>
        </div>
        <%= submit_tag "Justificar", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
      <% end %>
    <% end %>
  </section>
</div>
