<% filters = @list_filters || { q: "", kind: "", date_from: "", date_to: "", sort: "date", dir: "desc" } %>
<div id="sem-mes">
  <h2 class="mb-4 border-b border-rule pb-2 text-lg leading-6 font-semibold">Sem mês</h2>
  <%= render "shared/ledger_filters", url: "/supporting_documents", filters: filters %>
  <% if @documents.empty? %>
    <p>Nenhum documento</p>
  <% else %>
    <div class="ledger-sheet">
      <div class="ledger-row ledger-head ledger-doc">
        <%= ledger_sort_cell("Data", column: "date", current_sort: filters[:sort], current_dir: filters[:dir], base_path: "/supporting_documents", filter_params: filters) %>
        <span>Favorecido</span>
        <span>Tipo</span>
        <%= ledger_sort_cell("Valor", column: "amount", current_sort: filters[:sort], current_dir: filters[:dir], base_path: "/supporting_documents", filter_params: filters, align: :right) %>
        <span>Ações</span>
      </div>
      <ul>
      <% @documents.each do |document| %>
        <li data-row="document" data-document-id="<%= document.id %>" class="ledger-row ledger-doc">
          <time datetime="<%= document.document_on.iso8601 %>" class="tabular-nums"><%= l(document.document_on) %></time>
          <div data-cell="payee" class="min-w-0">
            <p class="font-medium"><%= document.payee %></p>
            <% if document.photo.attached? || document.xml.attached? %>
              <p class="text-meta text-ink-soft break-all"><%= [ document.photo.attached? ? document.photo.filename : nil, document.xml.attached? ? document.xml.filename : nil ].compact.join(", ") %></p>
            <% end %>
            <% if document.observation.present? %>
              <p class="text-meta text-ink-soft"><%= document.observation %></p>
            <% end %>
            <% if coordinator_on_focus? && document.month %>
              <p class="text-meta text-ink-soft">
                Sem casamento em <%= document.month.year_month %>
              </p>
            <% end %>
          </div>
          <p data-cell="kind"><%= document.recibo? ? "Recibo" : "Nota fiscal" %></p>
          <p data-cell="amount" class="font-medium tabular-nums"><%= format_reais(document.amount_cents) %></p>
          <%= render "shared/ledger_row_actions",
            edit_path: "/supporting_documents/#{document.id}/edit",
            delete_path: "/supporting_documents/#{document.id}",
            can_delete: document.month_id.nil? && (coordinator_on_focus? || document.account_id == current_account.id),
            delete_confirm: "Excluir este documento?" %>
        </li>
      <% end %>
      </ul>
    </div>
  <% end %>
</div>
