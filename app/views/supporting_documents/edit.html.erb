<% content_for :title, "Editar documento" %>
<% document = @document %>
<% recibo = document.recibo? %>
<% locked = document.fields_locked? %>
<% can_delete = document.month_id.nil? && (coordinator_on_focus? || document.account_id == current_account.id) %>

<p>
  <%= link_to "Voltar para documentos", "/supporting_documents", class: "text-caixa underline underline-offset-2" %>
</p>
<h1 class="mt-4 text-2xl leading-7 font-semibold tracking-[-0.01em]">Editar documento</h1>

<%= render "shared/notice", message: @document_error.to_s %>

<% if document.sefaz_confirm_pending? %>
  <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-3 border-l-[3px] border-margem pl-3 text-margem" role="status">
    <p class="min-w-[16rem] flex-1">A SEFAZ devolveu dados desta chave.</p>
    <%= button_to "Usar dados da SEFAZ", "/supporting_documents/#{document.id}/sefaz_confirm", method: :post, class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
  </div>
<% end %>

<div data-edit="split" class="mt-12 grid items-start gap-12 md:grid-cols-[minmax(0,1fr)_28rem] md:gap-8">
  <aside data-edit="proof">
    <div class="rounded border border-rule bg-sheet p-4">
      <div class="grid max-h-[28rem] aspect-[3/4] place-items-center overflow-hidden border border-rule bg-paper">
        <% if document.photo.attached? && document.photo.content_type.to_s.start_with?("image/") %>
          <%= image_tag url_for(document.photo), alt: document.photo.filename.to_s, class: "max-h-[28rem] w-full object-contain" %>
        <% elsif document.photo.attached? %>
          <p class="p-4 text-meta text-ink-soft"><%= document.photo.filename %></p>
        <% else %>
          <p class="p-4 text-meta text-ink-soft">Nenhuma foto</p>
        <% end %>
      </div>
      <% if document.photo.attached? %>
        <p class="mt-3 text-meta text-ink-soft">Foto · <%= document.photo.filename %></p>
      <% elsif document.xml.attached? %>
        <p class="mt-3 text-meta text-ink-soft">XML · <%= document.xml.filename %></p>
      <% end %>
      <% if document.photo.attached? || document.xml.attached? %>
        <p class="mt-1 text-meta text-ink-soft"><%= SupportingDocument::PHOTO_LOCKED %></p>
      <% end %>
      <% if document.photo.attached? && document.xml.attached? %>
        <p class="mt-1 text-meta text-ink-soft"><%= document.xml.filename %></p>
      <% end %>
    </div>
  </aside>

  <div data-edit="book" class="max-w-[28rem]">
    <%= form_with url: "/supporting_documents/#{document.id}", method: :patch, multipart: true, html: { id: "document-edit" }, class: "grid gap-4" do %>
      <div>
        <label for="arquivo" class="mb-1 block font-medium">Arquivo</label>
        <%= text_field_tag :arquivo, document.arquivo_kind, id: "arquivo", disabled: true, autocomplete: "off", class: "w-full rounded border border-rule bg-sheet px-3 py-2" %>
      </div>
      <div>
        <label for="kind" class="mb-1 block font-medium">Tipo</label>
        <%= select_tag :kind, options_for_select([ [ "Nota fiscal", "nota_fiscal" ], [ "Recibo", "recibo" ] ], document.kind), id: "kind", disabled: true, class: "w-full rounded border border-rule bg-sheet px-3 py-2" %>
      </div>
      <div>
        <label for="amount" class="mb-1 block font-medium">Valor</label>
        <%= text_field_tag :amount, format_reais(document.amount_cents).delete_prefix("R$ ").strip, id: "amount", disabled: locked, class: "w-full rounded border border-rule bg-sheet px-3 py-2 tabular-nums", autocomplete: "off", inputmode: "numeric", data: { controller: "money-mask", action: "input->money-mask#typed" } %>
        <p class="mt-1 text-meta text-ink-soft<%= " text-caixa" if locked %>" data-origin="amount"><%= document.origin_stamp %></p>
      </div>
      <div>
        <label for="date" class="mb-1 block font-medium">Data</label>
        <%= date_field_tag :date, document.document_on.iso8601, id: "date", disabled: locked, class: "w-full rounded border border-rule bg-sheet px-3 py-2 tabular-nums", autocomplete: "off" %>
        <p class="mt-1 text-meta text-ink-soft<%= " text-caixa" if locked %>" data-origin="date"><%= document.origin_stamp %></p>
      </div>
      <div>
        <label for="payee" class="mb-1 block font-medium">Favorecido</label>
        <%= text_field_tag :payee, document.payee, id: "payee", disabled: locked, class: "w-full rounded border border-rule bg-sheet px-3 py-2", autocomplete: "off" %>
        <p class="mt-1 text-meta text-ink-soft<%= " text-caixa" if locked %>" data-origin="payee"><%= document.origin_stamp %></p>
      </div>
      <% unless recibo %>
        <div>
          <label for="chave" class="mb-1 block font-medium">Chave de acesso (opcional)</label>
          <%= text_field_tag :chave, document.chave, id: "chave", class: "w-full rounded border border-rule bg-sheet px-3 py-2 font-mono text-meta", autocomplete: "off" %>
        </div>
      <% end %>
      <div>
        <label for="observation" class="mb-1 block font-medium">Observação (opcional)</label>
        <%= text_area_tag :observation, document.observation, id: "observation", class: "w-full rounded border border-rule bg-sheet px-3 py-2", rows: 3 %>
      </div>
      <div data-edit="actions" class="mt-2 flex flex-wrap items-center gap-4">
        <%= submit_tag "Salvar documento", class: "rounded bg-caixa px-4 py-2 font-semibold text-white" %>
        <% if can_delete %>
          <%= button_tag "Excluir", type: "submit", form: "document-destroy", class: "text-margem underline underline-offset-2" %>
        <% end %>
      </div>
    <% end %>
    <% if can_delete %>
      <%= form_with url: "/supporting_documents/#{document.id}", method: :delete, html: { id: "document-destroy", data: { turbo_confirm: "Excluir este documento?" } } do %>
      <% end %>
    <% end %>
  </div>
</div>
