{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/guard-shell.js",
        "timeout": 10
      }
    ],
    "beforeReadFile": [
      {
        "command": "node .cursor/hooks/guard-read.js",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
