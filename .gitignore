# Ignore bundler config.
/.bundle

# Ignore all environment files (secrets). Keep example templates.
/.env
/.env.*
!/.env.example
!/.env.sample
!/.env.template

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

/app/assets/builds/*
!/app/assets/builds/.keep

# OS and editor
.DS_Store
node_modules/

# Test and build
/coverage/
/vendor/bundle

# Local editor / agent clutter
.agent/
.agents/
.scratch/
.harness-eval/
.impeccable/mocks/
.impeccable/questions/
.impeccable/surfaces/

# Lefthook machine-local overrides (lefthook.yml is committed)
.lefthook-local.yml
